@model List<Movie>

<table class="table table-striped table-hover table-bordered shadow-sm">
    <thead class="table-light text-center">
        <tr>
            <th>#</th>
            <th>Category</th>
            <th>Title</th>
            <th>Year</th>
            <th>Director</th>
            <th>Rating</th>
            <th>Edited</th>
            <th>Lent To</th>
            <th>Copied to Plex</th>
            <th>Notes</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var movie in Model)
        {
            <tr>
                <td class="text-center">@movie.MovieId</td>
                <td>@movie.Category?.CategoryName</td>
                <td>@movie.Title</td>
                <td class="text-center">@movie.Year</td>
                <td>@movie.Director</td>
                <td class="text-center">@movie.Rating</td>
                <td class="text-center">@movie.Edited</td>
                <td>@movie.LentTo</td>
                <td class="text-center">@movie.CopiedToPlex</td>
                <td class="small">@movie.Notes</td>
                <td class="text-center">
                    <a class="btn btn-sm btn-info" asp-controller="Home" asp-action="Edit" asp-route-id="@movie.MovieId">
                        <i class="bi bi-pencil-square"></i> Edit
                    </a>
                    <a class="btn btn-sm btn-danger" asp-controller="Home" asp-action="Delete" asp-route-id="@movie.MovieId">
                        <i class="bi bi-trash"></i> Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
