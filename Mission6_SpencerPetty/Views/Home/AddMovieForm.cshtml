@{
    ViewData["Title"] = "Add Movie Form";
}
@model Movie

<h1>@ViewData["Title"]</h1>

<form method="post">
        <input type="hidden" asp-for="MovieId" />
    <div>
        <label asp-for="Title">Title:</label>
        <input asp-for="Title" required />
    </div>
    <div>
        <label asp-for="CategoryId">Category:</label>
        <select asp-for="CategoryId">
            <option value="">-- Select Category --</option>
            @foreach (Category category in ViewBag.Categories)
            {
				<option value="@category.CategoryId">@category.CategoryName</option>
            }
        </select>
    </div>
    <div>
        <label asp-for="Year">Year:</label>
        <input asp-for="Year" type="number" min="1888" max="2100" required />
    </div>
    <div>
        <label asp-for="Director">Director:</label>
        <input asp-for="Director" />
    </div>
    <div>
        <label asp-for="Rating">Rating:</label>
        <select asp-for="Rating">
            <option value="">-- Select Rating --</option>
            <option value="G">G</option>
            <option value="PG">PG</option>
            <option value="PG-13">PG-13</option>
            <option value="R">R</option>
        </select>
    </div>
    <div>
        <label>Edited:</label>
        <select asp-for="Edited" required>
            <option value="true">Yes</option>
            <option value="false">No</option>
        </select>
    </div>
    <div>
        <label>Copied to Plex:</label>
        <select asp-for="CopiedToPlex" required>
            <option value="true">Yes</option>
            <option value="false">No</option>
        </select>
    </div>
    <div>
        <label asp-for="LentTo">Lent To:</label>
        <input asp-for="LentTo" />
    </div>
    <div>
        <label asp-for="Notes">Notes (Max 25 chars):</label>
        <input asp-for="Notes" maxlength="25" />
    </div>
    <button type="submit">Submit</button>
</form>

